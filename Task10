import java.util.Scanner;
public class Task10 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] a = new int[5];
        int[] b = new int[5];
        System.out.println("Enter first 5 numbers:");
        for (int i = 0; i < 5; i++) a[i] = sc.nextInt();
        System.out.println("Enter second 5 numbers:");
        for (int i = 0; i < 5; i++) b[i] = sc.nextInt();
        int[] c = new int[10];
        for (int i = 0; i < 5; i++) c[i] = a[i];
        for (int i = 0; i < 5; i++) c[5+i] = b[i];
        System.out.print("Merged: ");
        for (int i = 0; i < 10; i++) System.out.print(c[i] + " ");
        System.out.println();
        int max = c[0];
        for (int i = 0; i < 10; i++) if (c[i] > max) max = c[i];
        System.out.println("Largest = " + max);
        
    }
}
