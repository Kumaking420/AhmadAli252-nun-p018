import java.util.Scanner;
public class Task11 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int[] a = new int[5];
        int[] b = new int[5];
        
        System.out.println("Enter first 5 sorted numbers:");
        for (int i = 0; i < 5; i++) a[i] = sc.nextInt();
        
        System.out.println("Enter second 5 sorted numbers:");
        for (int i = 0; i < 5; i++) b[i] = sc.nextInt();
        
        int[] c = new int[10];
        int i = 0, j = 0, k = 0;
        
        while (i < 5 && j < 5) {
            if (a[i] <= b[j]) {
                c[k] = a[i];
                i++;
            } else {
                c[k] = b[j];
                j++;
            }
            k++;
        }
        
        while (i < 5) {
            c[k] = a[i];
            i++;
            k++;
        }
        
        while (j < 5) {
            c[k] = b[j];
            j++;
            k++;
        }
        
        System.out.print("Sorted merged: ");
        for (int x = 0; x < 10; x++) System.out.print(c[x] + " ");
        
        
    }
}
