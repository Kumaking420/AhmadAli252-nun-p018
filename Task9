import java.util.Scanner;
public class Task09 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();
        for (int i = 0; i < 10; i++) {
            int count = 0;
            for (int j = 0; j < 10; j++) if (arr[i] == arr[j]) count++;
            boolean printedBefore = false;
            for (int k = 0; k < i; k++) if (arr[k] == arr[i]) printedBefore = true;
            if (count > 1 && !printedBefore) {
                System.out.println(arr[i] + " occurs " + count + " times");
            }
        }
        
    }
}
